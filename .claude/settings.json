{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__playwright__browser_select_option",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:taxly.kr)",
      "Write(content/wiki/**)",
      "Edit(content/wiki/**)",
      "WebSearch",
      "WebFetch",
      "Bash(npm run build:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(node -e \":*)",
      "Bash(node scripts/create-batch2-forms.js)",
      "Bash(node scripts/append-preview-data-batch2.js)",
      "Bash(ls c:/Users/user/wiki-site/src/app/[category]/[slug]/)",
      "Bash(echo \"없음\" ls c:/Users/user/wiki-site/src/app/w/ cat c:/Users/user/wiki-site/src/app/w/[slug]/page.tsx)",
      "Bash(head -50 c:/Users/user/wiki-site/src/app/w/[slug]/page.tsx)",
      "Bash(grep -n \"getBlogBySlug\\\\|getWikiDocument\\\\|getSpokeBySlug\\\\|getSpokeArticle\\\\|優先순위\\\\|routing\" c:/Users/user/wiki-site/src/app/w/[slug]/page.tsx)",
      "Read(//c/Users/user/law-jjyu/scripts/**)",
      "Read(//c/Users/user/law-jjyu/.claude/skills/article-writing/**)",
      "Bash(node scripts/verify-8rules.js --all)",
      "Bash(ls c:/Users/user/wiki-site/src/app/[category]/)"
    ],
    "deny": [],
    "additionalDirectories": [
      "c:\\Users\\user\\wiki-site\\.claude\\skills"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.INPUT||''; const blocked=['실업급여-계산기','퇴직금-계산기','연말정산-계산기','4대보험료-계산기','DSR-계산기','건강보험료-계산기','국민연금-수령액-계산기','근로소득세-계산기','대출상환-계산기','대출이자-계산기','양도소득세-계산기','연봉-계산기','시급-계산기','주휴수당-계산기','취득세-계산기','증여세-계산기','상속세-계산기','종합부동산세-계산기','재산세-계산기']; const hit=blocked.find(s=>p.includes('src/app/w/'+s+'/')); if(hit){console.error('🚫 계산기 페이지 수정 차단: '+hit); process.exit(1)}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node c:/Users/user/wiki-site/scripts/verify-tsx-article.js"
          }
        ]
      }
    ]
  },
  "editMode": "ask"
}
