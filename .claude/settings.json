{
  "permissions": {
    "allow": [
      "mcp__playwright__browser_select_option",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:taxly.kr)",
      "Write(/src/data/spoke/**)",
      "Write(/src/data/hub/**)",
      "Write(/src/components/checkers/**)",
      "Edit(/src/data/spoke/**)",
      "Edit(/src/data/hub/**)",
      "Edit(/src/components/checkers/**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Write(/.claude/**)",
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-spoke-quality.js",
            "timeout": 30,
            "statusMessage": "스포크/허브 품질 검증 중..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/task-complete-verify.js",
            "timeout": 60,
            "statusMessage": "태스크 완료 검증 중..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/teammate-idle-check.js",
            "timeout": 30,
            "statusMessage": "팀원 idle 검증 중..."
          }
        ]
      }
    ]
  },
  "editMode": "ask",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
