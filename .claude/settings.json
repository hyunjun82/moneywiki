{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git merge:*)",
      "Bash(npm run build:*)",
      "Bash(node scripts/*)",
      "Bash(node -e :*)",
      "Write(content/wiki/**)",
      "Edit(content/wiki/**)",
      "Read(//c/Users/user/law-jjyu/**)",
      "Bash(git add *)",
      "Bash(git commit -q -m ' *)",
      "Bash(git push *)",
      "Bash(node -e ' *)",
      "Bash(node scripts/collect-keywords.mjs ISA계좌 --q \"ISA계좌\" --q \"ISA 계좌 개편\" --q \"청년 ISA 계좌\")",
      "Bash(node scripts/collect-keywords.mjs ISA계좌 --q \"ISA계좌\" --q \"ISA 계좌 개편\" --q \"청년 ISA 계좌\" --q \"ISA 계좌 출금\")",
      "Bash(node scripts/verify-rendered.mjs --base http://localhost:3000 ISA계좌-세금혜택 ISA계좌-단점 ISA계좌-추천 ISA계좌-ETF-추천 ISA계좌-수익률)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/require-template.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/block-websearch.mjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/protect-assets.mjs"
          }
        ]
      }
    ]
  }
}
