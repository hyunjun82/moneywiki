{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git merge:*)",
      "Bash(npm run build:*)",
      "Bash(node scripts/*)",
      "Bash(node -e :*)",
      "Write(content/wiki/**)",
      "Edit(content/wiki/**)",
      "Read(//c/Users/user/law-jjyu/**)",
      "Bash(git add *)",
      "Bash(git commit -q -m ' *)",
      "Bash(git push *)",
      "Bash(node -e ' *)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/block-websearch.mjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/protect-assets.mjs"
          }
        ]
      }
    ]
  }
}
