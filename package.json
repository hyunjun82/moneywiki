{
  "name": "wiki-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate": "py scripts/validate-all.py",
    "validate-static": "node scripts/validate-force-static.js",
    "verify:articles": "npx tsx scripts/verify-articles.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node scripts/gen-favicon-manifest.mjs && node scripts/build-keyword-links.mjs --write && node scripts/build-link-fixes.mjs --write && node scripts/build-category-redirects.mjs --write && node scripts/verify-internal-links.mjs && node fix-imports-v2.js && npx tsx scripts/verify-articles.ts && node scripts/verify-evidence.mjs",
    "postbuild": "node scripts/clean-out-txt.js",
    "evidence": "node scripts/collect-evidence.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:rendered": "node scripts/verify-rendered.mjs",
    "verify:links": "npx tsx scripts/verify-links.ts",
    "verify:internal-links": "node scripts/verify-internal-links.mjs",
    "keywords": "node scripts/collect-keywords.mjs",
    "verify:repetition": "npx tsx scripts/verify-repetition.ts",
    "verify:claims": "npx tsx scripts/verify-claims.ts",
    "verify:meaning": "npx tsx scripts/verify-meaning.ts",
    "brief": "node scripts/brief.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "autofix": "node scripts/autofix.mjs",
    "write": "node scripts/write.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/redis": "^1.36.1",
    "@vercel/analytics": "^1.6.1",
    "autoprefixer": "^10.4.23",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.576.0",
    "next": "16.1.1",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "20.19.30",
    "@types/react": "19.2.10",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "playwright": "^1.57.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.3"
  }
}
