#!/bin/sh
#
# Git Pre-Push: 품질 게이트 (2026-09-03 정리)
#
# 실제 사고를 잡았던 검사만 막는다. 형태 검사(타이틀 공식·블록 순서·상투구)는 없앴다 —
# 형태를 통과한 글이 내용은 비었던 것이 지난 8개월의 결론이다. 형태는 정본 템플릿 1편이 정한다.
#   · verify-evidence       본문 숫자 ↔ 증거 JSON            (근거 없는 숫자 차단)
#   · verify-internal-links 죽은 /w/·/category/·루트 링크    (네이버 404 540건 사고 재발 방지)
# 화면·뜻 검사(verify-rendered·verify-meaning)는 시간이 걸려 push 전에 손으로 돈다.

echo ""
echo "══════════ Pre-Push 품질 게이트 ══════════"

UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo origin/main)
RANGE_FILES=$(git diff --name-only "$UPSTREAM"..HEAD 2>/dev/null)
if [ -z "$RANGE_FILES" ]; then
    echo "변경 파일 없음 — 통과"
    exit 0
fi

# ── 게이트 1: 글 변경 시 숫자 근거 ──
if echo "$RANGE_FILES" | grep -q "^src/data/articles/.*\.ts$"; then
    echo ""
    echo "▶ verify:evidence (본문 숫자 ↔ 증거 JSON)"
    node scripts/verify-evidence.mjs || { echo "✗ verify:evidence 실패 — push 차단"; exit 1; }
fi

# ── 게이트 2: 새 글이 옛 TSX 에 가려지는지 ──
# src/app/w/<slug>/page.tsx 가 [slug] 보다 먼저 잡혀 화면에는 옛 글이 나온다.
# 2026-09-03 에 이 이유로 5편 중 4편을 다시 손봤다. 배포 전에 막는다.
if echo "$RANGE_FILES" | grep -qE "^src/data/articles/|^src/app/w/"; then
    echo ""
    echo "▶ verify:no-shadow (옛 TSX 가 새 글을 가리는지)"
    node scripts/verify-no-shadow.mjs || { echo "✗ 가려진 글 있음 — push 차단"; exit 1; }
fi

# ── 게이트 3: 내부 링크 ──
if echo "$RANGE_FILES" | grep -qE "^content/wiki/|^src/app/|^src/components/|^src/data/|^public/_redirects"; then
    echo ""
    echo "▶ verify:internal-links (죽은 내부 링크)"
    node scripts/verify-internal-links.mjs || { echo "✗ 죽은 내부 링크 — push 차단"; exit 1; }
fi

# ── 참고 4: 바뀜 글의 뜻 검사 — 경고만, 막지 않는다 (2026-09-06) ──
# LLM 판정은 같은 글에 돌릴 때마다 다른 것을 잡아 push 를 되풀이해 막았다(7바퀴). 결정적 검사(1~3)만 막고
# 이건 읽을 거리로 남긴다. 지적이 있으면 npm run audit <slug> 로 확인한다.
# 예전처럼 막으려면 STRICT_MEANING=1 git push · 아예 건너뛰려면 SKIP_MEANING=1 git push
if [ -z "$SKIP_MEANING" ] && echo "$RANGE_FILES" | grep -q "^src/data/articles/.*\.ts$"; then
    echo ""
    echo "▶ verify:meaning (바뀜 글만 — 경고)"
    if ! node scripts/verify-meaning-changed.mjs "$UPSTREAM"; then
        if [ -n "$STRICT_MEANING" ]; then echo "✗ 뜻 검사 실패 — STRICT_MEANING 으로 push 차단"; exit 1; fi
        echo "⚠ 뜻 검사 지적이 있습니다 (push 는 막지 않음). npm run audit <slug> 로 읽어 보세요."
    fi
fi

echo "✓ 게이트 통과"
echo ""
exit 0
