BEGIN {
    FS = "-"
    print "파일명,베이스키워드,제안제목,키워드1,키워드2,키워드3,키워드4,키워드5"
}

{
    file = $0
    gsub(/\.md$/, "", file)
    
    # 베이스 키워드 결정
    if (file ~ /계산/) {
        base = "퇴직금 계산"
        k1 = "퇴직금 계산"
        k2 = "퇴직금 계산 방법"
        k3 = "퇴직금 계산 기준"
        k4 = "퇴직금 계산법"
        k5 = "퇴직금 계산기"
    }
    else if (file ~ /평균임금/) {
        base = "퇴직금 평균임금"
        k1 = "퇴직금 평균임금"
        k2 = "평균임금 산정"
        k3 = "평균임금 계산"
        k4 = "퇴직금 평균임금 계산"
        k5 = "평균임금 확인"
    }
    else if (file ~ /지연이자/) {
        base = "퇴직금 지연이자"
        k1 = "퇴직금 지연이자"
        k2 = "퇴직금 지연이자 받기"
        k3 = "지연이자 계산"
        k4 = "퇴직금 미지급 지연이자"
        k5 = "지연이자 청구"
    }
    else if (file ~ /미지급/) {
        base = "퇴직금 미지급"
        k1 = "퇴직금 미지급"
        k2 = "퇴직금 미지급 신고"
        k3 = "퇴직금 미지급 받기"
        k4 = "퇴직금 미지급 청구"
        k5 = "퇴직금 미지급 처벌"
    }
    else {
        base = "퇴직금"
        k1 = "퇴직금"
        k2 = "퇴직금 " $2
        k3 = "퇴직금 " $3
        k4 = "퇴직금 " $4
        k5 = "퇴직금 받기"
    }
    
    # 제목 생성
    title = ""
    for (i = 2; i <= NF && i <= 4; i++) {
        if (i > 2) title = title "·"
        title = title $i
    }
    if (title !~ /받|신청|조건|방법/) {
        title = title "·받는법"
    }
    
    printf "\"%s.md\",\"%s\",\"%s\",\"%s\",\"%s\",\"%s\",\"%s\",\"%s\"\n", file, base, title, k1, k2, k3, k4, k5
}
